# ─── Application ─────────────────────────────────────────────
APP_PORT=8080
GIN_MODE=release

# ─── Database (TiDB) ────────────────────────────────────────
TIDB_HOST=tidb
TIDB_PORT=4000
TIDB_USER=noant
TIDB_PASSWORD=noantpass
TIDB_DATABASE=noant
TIDB_DSN=noant:noantpass@tcp(tidb:4000)/noant?charset=utf8mb4&parseTime=True&loc=Local

# ─── Cache (Redis) ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Monitoring ──────────────────────────────────────────────
GF_ADMIN_PASSWORD=admin
