# NOANT Production Environment
# Copy to .env and fill in values before deploying

# ─── Database (TiDB Cloud free tier) ──────────────────────────
# Get from: https://tidbcloud.com → Serverless → Connect
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_user
TIDB_PASSWORD=your_password
TIDB_DBNAME=noant

# ─── Redis ─────────────────────────────────────────────────────
# If using Docker Redis on this host:
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password_here

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_random_64_char_string
CSRF_SECRET=replace_with_random_64_char_string

# ─── App Config ────────────────────────────────────────────────
NODE_ENV=production
GIN_MODE=release
PORT=8080
API_URL=https://yourdomain.com
APP_NAME=noant

# ─── AI ────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── WhatsApp (OpenWA) ────────────────────────────────────────
OPENWA_ENABLED=true
OPENWA_SESSION_DIR=/app/data/openwa

# ─── Polar (Payments) ──────────────────────────────────────────
POLAR_ACCESS_TOKEN=your_polar_token
POLAR_WEBHOOK_SECRET=your_webhook_secret
POLAR_ENVIRONMENT=production

# ─── Sentry (Error Tracking) ───────────────────────────────────
SENTRY_DSN=https://17af0530920ee74be952f7ae22c8f89d@o4511779671375872.ingest.us.sentry.io/4511779682516992
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Domain ────────────────────────────────────────────────────
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=you@email.com
